<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mismos límites que Unity: netstandard2.1 y C# 9 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stub\*.cs" />
    <Compile Include="ProyectoUnity\Assets\Scripts\Runtime\*.cs" />
    <Compile Include="ProyectoUnity\Assets\Scripts\Tests\EditMode\*.cs" />
    <ProjectReference Include="..\src\Juego.Core\Juego.Core.csproj" />
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>
</Project>
